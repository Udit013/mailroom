# Replace the host name before installing. See docs/DEPLOY.md.
your-name.duckdns.org {
	# Slightly above MAX_UPLOAD_BYTES, which the API enforces exactly.
	request_body {
		max_size 11MB
	}

	handle_path /api/* {
		# Opens real connections on each call. Check it from the VM instead.
		respond /readyz 404
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/mailroom
		try_files {path} /index.html
		file_server
	}
}
