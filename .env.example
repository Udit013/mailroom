# Copy to .env, which is gitignored, and choose your own passwords.
# Passwords are placed inside connection URLs, so use letters, digits and hyphens only.
POSTGRES_USER=mailroom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mailroom
RABBITMQ_USER=mailroom
RABBITMQ_PASSWORD=change-me
API_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760

# Optional model advisor, off by default. Read the Model advisor section of README.md first:
# Gemini's free tier may use what it is sent, so only synthetic documents are allowed.
# ADVISOR=gemini
# ADVISOR_SYNTHETIC_DATA_ONLY=true
# GEMINI_API_KEY=
